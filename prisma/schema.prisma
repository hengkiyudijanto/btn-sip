// Skema database SIP — Bank BTN
// Prisma + PostgreSQL (Neon)
//
// Catatan desain:
// - `nilaiAkhir` & `kontribusi` per kategori DISIMPAN (snapshot) supaya laporan
//   lama tidak berubah kalau bobot diubah di kemudian hari.
// - `bobotTersimpan` (JSON) ikut disimpan sebagai jejak audit versi bobot.
// - Password disimpan sebagai hash, TIDAK pernah plaintext.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// MASTER DATA
// ===========================================================================

/// Jenis unit kerja dalam hierarki BTN.
enum JenisCabang {
  KANWIL /// Kantor Wilayah — level tertinggi
  KC /// Kantor Cabang
  KCP /// Kantor Cabang Pembantu
}

/// Cabang / unit kerja. `kode` dipakai sebagai filter penilaian.
/// Hierarki dibentuk lewat relasi `induk` (self-relation): Kanwil > KC > KCP.
model Cabang {
  id        String       @id @default(cuid())
  kode      String       @unique // mis. "0001"
  nama      String
  jenis     JenisCabang  @default(KC)
  alamat    String?
  aktif     Boolean      @default(true)

  /// cabang induk dalam hierarki; null = level teratas (Kanwil)
  indukId   String?
  induk     Cabang?      @relation("HierarkiCabang", fields: [indukId], references: [id])
  turunan   Cabang[]     @relation("HierarkiCabang")

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  pegawai   Pegawai[]

  @@index([kode])
  @@index([indukId])
  @@index([jenis])
  pengajuan     PengajuanPegawai[]
}

/// Jabatan yang dinilai. Bobot penilaian seragam untuk semua jabatan.
model Jabatan {
  id        String   @id @default(cuid())
  kode      String   @unique // TELLER, CS, SECURITY, PB_TELLER, PB_CS
  nama      String   // "Teller"
  namaEn    String?  // "Teller"
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())

  pegawai   Pegawai[]

  @@index([kode])
  pengajuan     PengajuanPegawai[]
}

enum Role {
  PEGAWAI    // melihat hasil penilaian sendiri
  SUPERVISOR // menilai petugas
  MANAGER    // mengetahui/mengakui penilaian
  ADMIN      // kelola master data, periode, akun
}

/// Pegawai sekaligus pengguna aplikasi. Login memakai NIP + password.
model Pegawai {
  id            String   @id @default(cuid())
  nip           String   @unique
  nama          String
  email         String?  @unique
  /// URL foto eksternal (kalau ada). Untuk unggahan, pakai kolom fotoData.
  fotoUrl       String?
  /// Foto 3x4 tersimpan sebagai data URL (base64) — Vercel tidak punya
  /// filesystem persisten, jadi gambar kecil disimpan di database.
  fotoData      String?
  /// Metadata foto untuk ditampilkan tanpa memuat gambarnya.
  fotoMime      String?
  fotoUkuran    Int?
  fotoDiperbarui DateTime?
  passwordHash  String
  role          Role     @default(PEGAWAI)
  aktif         Boolean  @default(true)

  /// wajib ganti password saat login pertama / setelah reset admin
  harusGantiPassword Boolean @default(true)
  lastLoginAt   DateTime?

  cabangId      String
  cabang        Cabang   @relation(fields: [cabangId], references: [id])
  jabatanId     String?
  jabatan       Jabatan? @relation(fields: [jabatanId], references: [id])

  /// atasan langsung (untuk default penilai)
  atasanId      String?
  atasan        Pegawai?  @relation("AtasanBawahan", fields: [atasanId], references: [id])
  bawahan       Pegawai[] @relation("AtasanBawahan")

  penilaianku   Penilaian[] @relation("PegawaiDinilai")
  penilaiankuSebagaiPenilai Penilaian[] @relation("Penilai")
  penilaiankuSebagaiMengetahui Penilaian[] @relation("Pengetahui")
  auditLog      AuditLog[]
  sesi          Sesi[]

  /// pengajuan pegawai yang dibuat supervisor ini
  pengajuanDiajukan       PengajuanPegawai[] @relation("PengajuanOleh")
  /// pengajuan yang diputuskan admin ini
  pengajuanDiputus        PengajuanPegawai[] @relation("PengajuanDiputuskan")
  /// pengajuan yang menunjuk pegawai ini sebagai atasan
  pengajuanSebagaiAtasan  PengajuanPegawai[] @relation("PengajuanAtasan")
  /// pengajuan yang menghasilkan pegawai ini
  pengajuanHasil          PengajuanPegawai?  @relation("PengajuanHasil")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cabangId])
  @@index([jabatanId])
  @@index([role])
}

// ===========================================================================
// PERIODE
// ===========================================================================

/// Periode penilaian mingguan. Kombinasi tanggal mulai unik.
model Periode {
  id          String   @id @default(cuid())
  kode        String   @unique // mis. "2026-W40"
  nama        String   // "Minggu ke-40 (29 Sep - 5 Okt 2026)"
  tanggalMulai DateTime
  tanggalSelesai DateTime
  aktif       Boolean  @default(true)
  dikunci     Boolean  @default(false) // kalau true, penilaian tidak bisa diubah
  createdAt   DateTime @default(now())

  penilaian   Penilaian[]

  @@index([tanggalMulai])
  @@unique([tanggalMulai, tanggalSelesai])
}

// ===========================================================================
// PENILAIAN
// ===========================================================================

enum StatusPenilaian {
  DRAFT      // penilai masih mengisi
  DIKIRIM    // sudah submit, menunggu diketahui atasan
  DIKETAHUI  // atasan penilai sudah acknowledge
  FINAL      // dikunci, siap cetak
}

model Penilaian {
  id          String   @id @default(cuid())

  pegawaiId   String
  pegawai     Pegawai  @relation("PegawaiDinilai", fields: [pegawaiId], references: [id])

  penilaiId   String
  penilai     Pegawai  @relation("Penilai", fields: [penilaiId], references: [id])

  /// atasan yang "mengetahui" — bisa sama dengan penilai
  mengetahuiId String?
  mengetahui   Pegawai? @relation("Pengetahui", fields: [mengetahuiId], references: [id])

  periodeId   String
  periode     Periode  @relation(fields: [periodeId], references: [id])

  status      StatusPenilaian @default(DRAFT)

  // --- hasil perhitungan (snapshot) ---
  nilaiPenampilan Float? // kategori A, skala 1-5
  nilaiKemampuan  Float? // kategori B
  nilaiSikap      Float? // kategori C
  nilaiAkhir      Float? // skala 0-5
  rating          String? // "Istimewa" | "Sangat Baik" | ...

  /// jejak audit versi bobot yang dipakai saat menghitung
  bobotTersimpan  Json?

  catatanUmum String?

  // --- foto penilaian (satu foto per periode penilaian) ---
  // Dipisah dari foto pegawai: foto penilaian membuktikan kondisi petugas
  // pada periode itu, sementara foto pegawai adalah foto identitas.
  // Foto pegawai lama tetap tersimpan sebagai riwayat.
  /// Foto tersimpan sebagai data URL (base64), 3x4, maks 80 KB.
  fotoData       String?
  fotoMime       String?
  fotoUkuran     Int?
  fotoDiperbarui DateTime?
  /// keterangan singkat foto, mis. "seragam lengkap dengan name tag"
  fotoCatatan    String?

  detail      PenilaianDetail[]

  dikirimAt   DateTime?
  diketahuiAt DateTime?
  finalAt     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// satu pegawai satu penilaian per periode
  @@unique([pegawaiId, periodeId])
  @@index([penilaiId])
  @@index([periodeId, status])
  @@index([pegawaiId])
}

/// Nilai per aspek. `nilaiMentah` menyimpan angka asli yang diinput penilai
/// (1-5, atau 0-100 untuk quiz) supaya bisa diaudit.
model PenilaianDetail {
  id           String   @id @default(cuid())
  penilaianId  String
  penilaian    Penilaian @relation(fields: [penilaianId], references: [id], onDelete: Cascade)

  kodeAspek    String   // A1..A4, B1..B5, C1..C4
  nilaiMentah  Float    // apa yang diinput penilai
  skor         Int      // hasil konversi ke 1-5
  bobotAspek   Float    // snapshot bobot
  catatan      String?

  @@unique([penilaianId, kodeAspek])
  @@index([penilaianId])
}

// ===========================================================================
// AUDIT & SESI
// ===========================================================================

model AuditLog {
  id         String   @id @default(cuid())
  pegawaiId  String?
  pegawai    Pegawai? @relation(fields: [pegawaiId], references: [id])

  aksi       String   // "LOGIN", "UPDATE_PENILAIAN", "KUNCI_PERIODE", ...
  entitas    String?  // "Penilaian", "Pegawai", ...
  entitasId  String?
  dataLama   Json?
  dataBaru   Json?
  ip         String?
  userAgent  String?

  createdAt  DateTime @default(now())

  @@index([pegawaiId, createdAt])
  @@index([entitas, entitasId])
}

/// Sesi login (cookie/session token). Token disimpan sebagai hash.
model Sesi {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  pegawaiId   String
  pegawai     Pegawai  @relation(fields: [pegawaiId], references: [id], onDelete: Cascade)

  expiresAt   DateTime
  revokedAt   DateTime?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([pegawaiId])
  @@index([expiresAt])
}

// ===========================================================================
// PENGATURAN APLIKASI
// ===========================================================================

/**
 * Pengaturan global aplikasi (satu baris saja).
 * Dipakai untuk menyimpan hari penilaian periode, karena hari itu bisa
 * berubah di masa depan dan mempengaruhi perhitungan periode.
 */
model Pengaturan {
  id            String   @id @default("utama")
  /// 0=Minggu, 1=Senin, ... 6=Sabtu. Default 3 = Rabu.
  hariPenilaian Int      @default(3)
  /// tahun periode yang sudah dibuat otomatis
  periodeTerbuatSampaiTahun Int?
  diperbaruiOleh String?
  updatedAt     DateTime @updatedAt

  @@map("pengaturan")
}

// ===========================================================================
// PENGAJUAN PEGAWAI
// ===========================================================================

enum StatusPengajuan {
  MENUNGGU // diajukan supervisor, menunggu admin
  DISETUJUI // admin menyetujui, pegawai sudah dibuat
  DITOLAK // admin menolak
}

/**
 * Pengajuan penambahan pegawai oleh supervisor.
 *
 * Supervisor sering menemukan petugas yang belum terdaftar saat hendak
 * menilai. Daripada memberi kewenangan penuh menambah pegawai (risiko NIP
 * ganda, salah cabang, pegawai fiktif), supervisor mengajukan dan admin
 * menyetujui.
 *
 * Password disimpan TER-HASH sejak pengajuan supaya admin tidak perlu
 * mengetik ulang, dan password asli tidak pernah terlihat siapa pun.
 */
model PengajuanPegawai {
  id     String          @id @default(cuid())
  status StatusPengajuan @default(MENUNGGU)

  /// data calon pegawai
  nip          String
  nama         String
  email        String?
  passwordHash String

  cabangId  String
  cabang    Cabang   @relation(fields: [cabangId], references: [id])
  jabatanId String?
  jabatan   Jabatan? @relation(fields: [jabatanId], references: [id])
  atasanId  String?
  atasan    Pegawai? @relation("PengajuanAtasan", fields: [atasanId], references: [id])

  /// yang mengajukan (supervisor)
  pengajuId      String
  pengaju        Pegawai @relation("PengajuanOleh", fields: [pengajuId], references: [id])
  catatanPengaju String?

  /// hasil keputusan admin
  diputuskanOlehId String?
  diputuskanOleh   Pegawai?  @relation("PengajuanDiputuskan", fields: [diputuskanOlehId], references: [id])
  catatanAdmin     String?
  diputuskanAt     DateTime?

  /// pegawai yang dihasilkan setelah disetujui
  pegawaiId String?  @unique
  pegawai   Pegawai? @relation("PengajuanHasil", fields: [pegawaiId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([cabangId])
  @@index([pengajuId])
}
