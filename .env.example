# Contoh konfigurasi environment — SALIN ke .env.local lalu isi nilainya.
# JANGAN commit .env.local (sudah ada di .gitignore).

# Koneksi database PostgreSQL (Neon).
# Ambil dengan: neon connection-string production
# atau dari Neon Console → Connection Details.
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""

# Koneksi tanpa connection pooling — dipakai untuk migrasi.
DATABASE_URL_UNPOOLED=""

# Nama branch Neon (mis. "production"). Opsional.
NEON_BRANCH=""

# === Untuk seeding akun admin pertama ===
# Jalankan: pnpm exec tsx scripts/seed-admin.ts
ADMIN_NIP="admin"
ADMIN_PASSWORD=""
ADMIN_NAMA="Administrator"
